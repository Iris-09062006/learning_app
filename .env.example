# Public Supabase configuration. Do not add real credentials to this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site origin used for auth redirect allowlist (e.g. password recovery).
# Must NOT contain a path; used to build <origin>/reset-password only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration (OpenAI-compatible)
AI_API_KEY=
# For document-to-lesson all three values are required. The URL must be reachable
# from the server runtime (for 9Router local dev: http://localhost:20128/v1/chat/completions).
# Never configure a localhost URL for a Vercel deployment unless a secured tunnel exists.
AI_PROVIDER_URL=
AI_PROVIDER_MODEL=

# Tavily Search and Extract (optional and server-only; never expose with a NEXT_PUBLIC_ prefix).
# Without it, Tavily-dependent actions are unavailable while file/PDF flows and builds still work.
TAVILY_API_KEY=
